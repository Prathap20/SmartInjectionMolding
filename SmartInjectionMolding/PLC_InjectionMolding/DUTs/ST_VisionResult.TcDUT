<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_VisionResult" Id="{53ed8d9f-00fd-4541-b07c-c10f3587e1ae}">
    <Declaration><![CDATA[TYPE ST_VisionResult :
STRUCT

    // Vision system status
    bReady       : BOOL;
    bBusy        : BOOL;

    // Result handshake
    bResultValid : BOOL;

    // Inspection result
    bPartPresent : BOOL;
    bPartOK      : BOOL;

    // Classification
    nDefectCode  : UINT;

    // Measured geometry
    // Currently stored in pixels
    fWidth       : REAL;
    fHeight      : REAL;
    fAngle       : REAL;

    // Identification of inspected part
    nProductID   : DINT;

END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>