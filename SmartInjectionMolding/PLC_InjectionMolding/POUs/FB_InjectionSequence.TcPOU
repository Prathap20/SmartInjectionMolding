<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_InjectionSequence" Id="{c68f31cf-8eaf-47e0-bbd6-155368de0ba2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_InjectionSequence
VAR_INPUT
    bEnable         : BOOL;
    bStopRequest    : BOOL;

    // Screw position
    bAtFront        : BOOL;   // ES101
    bAtRear         : BOOL;   // ES102

    // Mold position
    bMoldOpen       : BOOL;   // ES201
    bMoldClosed     : BOOL;   // ES202

    // Configuration
    tCoolingTime    : TIME;
    nProducedParts  : UDINT;
    nBatchSize      : UDINT;
	
	// Vision system
	bVisionReady       : BOOL;
	bVisionResultValid : BOOL;
	bVisionPartOK      : BOOL;
	bVisionOffline : BOOL;
	bVisionTimeout : BOOL;
END_VAR

VAR_OUTPUT
    eState          : E_SequenceState := E_SequenceState.SEQ_IDLE;

    // Equipment commands
    bRotateCmd      : BOOL;
    bInjectCmd      : BOOL;
    bOpenMoldCmd    : BOOL;
    bCloseMoldCmd   : BOOL;

    // Status
    bCycleActive    : BOOL;
    bPartCompleted  : BOOL;
    bStopComplete   : BOOL;
	
	// Vision handshake
	bVisionTrigger : BOOL;
	bVisionAck     : BOOL;

	// Quality result pulses
	bGoodPart     : BOOL;
	bRejectedPart : BOOL;
	
	// Production statistics
    tLastCycleTime : TIME := T#0MS;
END_VAR

VAR
    fbCoolingTimer  : TON;
	fbCycleTimer : TON;
	
    bStopLatched    : BOOL := FALSE;
	bCycleTiming : BOOL := FALSE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =====================================================
// DEFAULT OUTPUTS
// =====================================================

// Mechanical commands are generated by the active state.
// Therefore reset them at the beginning of every PLC scan.

bRotateCmd := FALSE;
bInjectCmd := FALSE;

bOpenMoldCmd := FALSE;
bCloseMoldCmd := FALSE;


// Vision handshake outputs are one-scan pulses.

bVisionTrigger := FALSE;
bVisionAck := FALSE;


// Production event outputs are also one-scan pulses.

bPartCompleted := FALSE;
bGoodPart := FALSE;
bRejectedPart := FALSE;

bStopComplete := FALSE;


// Sequence is considered active whenever RUN enables it.

bCycleActive := bEnable;


// =====================================================
// STOP REQUEST LATCH
// =====================================================

// Do not stop immediately.
// Remember the request and finish the current part first.

IF bEnable AND bStopRequest THEN
    bStopLatched := TRUE;
END_IF;


// Batch production complete

IF bEnable
   AND (nProducedParts >= nBatchSize) THEN

    bStopLatched := TRUE;

END_IF;


// =====================================================
// COOLING TIMER
// =====================================================

fbCoolingTimer(
    IN := (eState = E_SequenceState.SEQ_COOLING),
    PT := tCoolingTime
);

// =====================================================
// CYCLE TIME MEASUREMENT
// =====================================================

fbCycleTimer(
    IN := bCycleTiming,
    PT := T#24H
);

// =====================================================
// SEQUENCE DISABLED
// =====================================================

IF NOT bEnable THEN

    eState := E_SequenceState.SEQ_IDLE;

    bStopLatched := FALSE;
	bCycleTiming := FALSE;


// =====================================================
// AUTOMATIC PRODUCTION SEQUENCE
// =====================================================

ELSE

    CASE eState OF


        // -------------------------------------------------
        // IDLE
        // -------------------------------------------------

        E_SequenceState.SEQ_IDLE:

            // Always begin with the mold closed.

            IF NOT bMoldClosed THEN

                bCloseMoldCmd := TRUE;


            // A stop may already have been requested.

            ELSIF bStopLatched THEN

                bStopComplete := TRUE;


            // Machine is ready to produce the next part.

            ELSE

                // Start a new production cycle
    			bCycleTiming := TRUE;
				eState := E_SequenceState.SEQ_INJECT;

            END_IF;



        // -------------------------------------------------
        // INJECTION
        // -------------------------------------------------

        E_SequenceState.SEQ_INJECT:

            bInjectCmd := TRUE;

            // Injection continues until the screw reaches
            // the front end position.

            IF bAtFront THEN

                bInjectCmd := FALSE;

                eState := E_SequenceState.SEQ_COOLING;

            END_IF;



        // -------------------------------------------------
        // COOLING
        // -------------------------------------------------

        E_SequenceState.SEQ_COOLING:

            // fbCoolingTimer runs while this state is active.

            IF fbCoolingTimer.Q THEN

                eState := E_SequenceState.SEQ_DOSING;

            END_IF;



        // -------------------------------------------------
        // DOSING / SCREW RETURN
        // -------------------------------------------------

        E_SequenceState.SEQ_DOSING:

            bRotateCmd := TRUE;

            // Continue dosing until screw reaches rear position.

            IF bAtRear THEN

                bRotateCmd := FALSE;

                eState := E_SequenceState.SEQ_OPEN_MOLD;

            END_IF;



        // -------------------------------------------------
        // OPEN MOLD
        // -------------------------------------------------

        E_SequenceState.SEQ_OPEN_MOLD:

            bOpenMoldCmd := TRUE;

            IF bMoldOpen THEN

                bOpenMoldCmd := FALSE;

                eState := E_SequenceState.SEQ_EJECT;

            END_IF;



        // -------------------------------------------------
        // PART EJECTION
        // -------------------------------------------------

        E_SequenceState.SEQ_EJECT:

            // Part has physically completed the molding process.
            // MAIN uses this pulse to increment TotalParts.

            bPartCompleted := TRUE;

            // Newly produced part must now be inspected.

            eState := E_SequenceState.SEQ_VISION_TRIGGER;



        // -------------------------------------------------
        // VISION TRIGGER
        // -------------------------------------------------

        E_SequenceState.SEQ_VISION_TRIGGER:

            // Camera unavailable before inspection.
            // Current part cannot be verified, therefore reject
            // it and request a graceful machine stop.

            IF bVisionOffline OR bVisionTimeout THEN

                bRejectedPart := TRUE;

                bStopLatched := TRUE;

                eState := E_SequenceState.SEQ_CLOSE_MOLD;


            // Camera available and ready.

            ELSIF bVisionReady THEN

                // One-scan trigger pulse.

                bVisionTrigger := TRUE;

                eState := E_SequenceState.SEQ_VISION_WAIT;

            END_IF;



        // -------------------------------------------------
        // WAIT FOR VISION RESULT
        // -------------------------------------------------

        E_SequenceState.SEQ_VISION_WAIT:

            // Communication failure or inspection timeout
            // while waiting for result.

            IF bVisionOffline OR bVisionTimeout THEN

                // Treat unverified part as rejected.

                bRejectedPart := TRUE;

                // Finish safely and stop production.

                bStopLatched := TRUE;

                eState := E_SequenceState.SEQ_CLOSE_MOLD;


            // Normal inspection completed.

            ELSIF bVisionResultValid THEN

                eState := E_SequenceState.SEQ_SORT_PART;

            END_IF;



        // -------------------------------------------------
        // SORT / CLASSIFY PART
        // -------------------------------------------------

        E_SequenceState.SEQ_SORT_PART:

            IF bVisionPartOK THEN

                bGoodPart := TRUE;

            ELSE

                bRejectedPart := TRUE;

            END_IF;


            // Tell vision system that PLC has consumed result.

            bVisionAck := TRUE;


            // Continue machine cycle.

            eState := E_SequenceState.SEQ_CLOSE_MOLD;



        // -------------------------------------------------
        // CLOSE MOLD
        // -------------------------------------------------

        E_SequenceState.SEQ_CLOSE_MOLD:

            bCloseMoldCmd := TRUE;

            IF bMoldClosed THEN

                bCloseMoldCmd := FALSE;
				
				// Complete cycle time includes vision inspection
        		tLastCycleTime := fbCycleTimer.ET;

        		// Stop/reset timer before next cycle
        		bCycleTiming := FALSE;

                eState := E_SequenceState.SEQ_COMPLETE;

            END_IF;



        // -------------------------------------------------
        // CYCLE COMPLETE
        // -------------------------------------------------

        E_SequenceState.SEQ_COMPLETE:

            // Graceful stop requested or production batch complete.

            IF bStopLatched
               OR (nProducedParts >= nBatchSize) THEN

                bStopComplete := TRUE;

                eState := E_SequenceState.SEQ_IDLE;


            // Otherwise immediately start next product.

            ELSE

				// Start timing the next production cycle
    			bCycleTiming := TRUE;			
                eState := E_SequenceState.SEQ_INJECT;

            END_IF;



        // -------------------------------------------------
        // FALLBACK
        // -------------------------------------------------

        ELSE

            eState := E_SequenceState.SEQ_IDLE;

    END_CASE;

END_IF;]]></ST>
    </Implementation>
